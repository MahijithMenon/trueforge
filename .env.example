# ---- Model providers (at least one required) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model the erasure agent uses. Provider is inferred from the configured provider name.
TOMBSTONE_MODEL_PROVIDER=openai
TOMBSTONE_MODEL_NAME=gpt-5

# ---- TrueForge harness ----
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_PORT=8790

# ---- Datastores (real, run via docker compose) ----
DATABASE_URL=postgres://tombstone:tombstone@localhost:55432/tombstone
OBJECT_STORE_ROOT=./data/objects

# ---- Services ----
ERASURE_MCP_PORT=8811
ERASURE_MCP_PUBLIC_URL=http://localhost:8811/mcp
SERVER_PORT=8800
CONSOLE_PORT=5173

# Shared secret the control plane uses to call the erasure MCP server.
ERASURE_MCP_TOKEN=change-me-local-dev-only
