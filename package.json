{
  "name": "tombstone",
  "private": true,
  "version": "0.1.0",
  "description": "An auditable right-to-erasure agent built on the TrueForge agent harness.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d && node scripts/wait-for-postgres.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "harness": "node scripts/run-harness.mjs",
    "provision": "npm run -w @tombstone/server provision",
    "dev:mcp": "npm run -w @tombstone/erasure-mcp dev",
    "dev:server": "npm run -w @tombstone/server dev",
    "dev:console": "npm run -w @tombstone/console dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "globals": "^15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
